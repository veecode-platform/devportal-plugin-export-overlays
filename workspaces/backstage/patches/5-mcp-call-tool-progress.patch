+                  // scaffolder task event stream does (scaffolder-backend
+                  // router.ts: "res.flush() is only available with the
+                  // compression middleware"). setImmediate lets the transport
+                  // write the frame first.
+                  setImmediate(() => {
+                    (req?.res as { flush?: () => void } | undefined)?.flush?.();
+                  });
+                })
+                .catch(error => {
+                  this.logger?.debug(
+                    `Progress notification failed: ${toError(error).message}`,
+                  );
+                });
+            }, 15_000);
+      // The beat must never keep the process alive.
+      heartbeat?.unref();
+
