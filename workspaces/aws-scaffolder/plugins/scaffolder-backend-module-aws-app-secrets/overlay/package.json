{
  "name": "@veecode-platform/plugin-scaffolder-backend-module-aws-app-secrets",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "The app-secrets module for @backstage/plugin-scaffolder-backend: a scaffolder action and an actions-registry action that register an app's secrets in AWS Secrets Manager.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend"
  },
  "configSchema": "config.d.ts",
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "export-dynamic": "npx @red-hat-developer-hub/cli@1.11.2 plugin export"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1128.0",
    "@aws-sdk/client-secrets-manager": "^3.1128.0",
    "@aws-sdk/client-sts": "^3.1128.0",
    "yaml": "^2.5.1",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "@backstage/backend-plugin-api": "^1.9.2",
    "@backstage/catalog-model": "^1.10.2",
    "@backstage/config": "^1.3.8",
    "@backstage/plugin-catalog-node": "^2.2.6",
    "@backstage/plugin-scaffolder-node": "^0.13.4"
  },
  "devDependencies": {
    "@backstage/backend-plugin-api": "^1.9.2",
    "@backstage/backend-test-utils": "^1.11.4",
    "@backstage/catalog-model": "^1.10.2",
    "@backstage/cli": "^0.36.3",
    "@backstage/config": "^1.3.8",
    "@backstage/plugin-catalog-node": "^2.2.6",
    "@backstage/plugin-scaffolder-node": "^0.13.4",
    "@backstage/plugin-scaffolder-node-test-utils": "^0.3.12"
  },
  "files": [
    "dist",
    "config.d.ts"
  ]
